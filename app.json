{
  "expo": {
    "name": "TapForm",
    "slug": "tapform",
    "scheme": "tapform",
    "version": "1.0.0",
    "primaryColor": "#090A0A",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tapform.app",
      "versionCode": 1,
      "permissions": [
        "NFC",
        "READ_CONTACTS",
        "WRITE_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090A0A",
          "image": "./assets/tapform-mark.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090A0A",
            "image": "./assets/tapform-mark.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TapForm to scan secure QR codes",
          "microphonePermission": "Microphone is not used by TapForm",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow TapForm to add this shared card to your contacts when you choose."
        }
      ],
      "./plugins/withTapFormNfc",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
