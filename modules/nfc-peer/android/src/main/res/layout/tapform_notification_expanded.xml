<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tapform_notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tapform_expanded_org_mark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:contentDescription=""
            android:src="@drawable/tapform_notification_org" />
        <TextView
            android:id="@+id/tapform_expanded_organization"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#F2F2F0"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/tapform_expanded_template"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#E5E6E4"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium" />
    <TextView
        android:id="@+id/tapform_expanded_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="5dp"
        android:text="wants information from your Vault."
        android:textColor="#B8BCB9"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="REQUESTED INFORMATION"
            android:textColor="#AEB2AF"
            android:textSize="13sp"
            android:letterSpacing="0.06" />
        <TextView
            android:id="@+id/tapform_requested_more"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:textColor="#AEB2AF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333735"
        android:text="" />
    <LinearLayout
        android:id="@+id/tapform_required_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/tapform_optional_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:text="OPTIONAL"
            android:textColor="#AEB2AF"
            android:textSize="13sp"
            android:letterSpacing="0.06" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333735"
            android:text="" />
        <LinearLayout
            android:id="@+id/tapform_optional_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <include layout="@layout/tapform_notification_actions" />

</LinearLayout>
