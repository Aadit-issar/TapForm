<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tapform_notification_actions"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tapform_notification_decline"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/tapform_notification_button_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="DECLINE"
        android:textColor="#ECEDEB"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tapform_notification_share"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/tapform_notification_button_light"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="SHARE"
        android:textColor="#111313"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
