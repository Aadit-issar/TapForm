<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/tapform_field_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="" />
    <TextView
        android:id="@+id/tapform_field_label"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="#E3E5E2"
        android:textSize="17sp"
        android:textStyle="normal" />
    <FrameLayout
        android:id="@+id/tapform_field_exclusion"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:background="@drawable/tapform_notification_touch_target"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Toggle whether this field is shared">
        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:background="@drawable/tapform_notification_checkbox">
            <TextView
                android:id="@+id/tapform_field_excluded_mark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#F2F2F0"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
